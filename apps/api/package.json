{
  "name": "@cv-jobs-compatibility/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:psql": "docker compose -f ../../docker-compose.yml exec postgres sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "db:generate": "drizzle-kit generate",
    "db:wipe": "node scripts/wipe.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "build-worker": {
        "executor": "nx:run-commands",
        "// outputs": "The webpack plugin only infers targets from webpack.config.js, so this target has no inferred metadata. `serve-worker` reads outputs[0] to find the bundle - without it, @nx/js:node falls back to a path that does not exist.",
        "outputs": [
          "{projectRoot}/dist-worker"
        ],
        "options": {
          "command": "webpack-cli build --config webpack.worker.config.js",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "build-migrate": {
        "executor": "nx:run-commands",
        "// outputs": "Same reason as build-worker: the webpack plugin only infers targets from webpack.config.js, so this one has no inferred metadata.",
        "outputs": [
          "{projectRoot}/dist-migrate"
        ],
        "options": {
          "command": "webpack-cli build --config webpack.migrate.config.js",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "serve-worker": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build-worker"
        ],
        "options": {
          "buildTarget": "@cv-jobs-compatibility/api:build-worker",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@cv-jobs-compatibility/api:build-worker:development"
          },
          "production": {
            "buildTarget": "@cv-jobs-compatibility/api:build-worker:production"
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@cv-jobs-compatibility/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@cv-jobs-compatibility/api:build:development"
          },
          "production": {
            "buildTarget": "@cv-jobs-compatibility/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@cv-jobs-compatibility/constants": "workspace:*",
    "@cv-jobs-compatibility/prompt-schemas": "workspace:*",
    "@cv-jobs-compatibility/types": "workspace:*",
    "@google/genai": "^2.18.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/id-generator-aws-xray": "^2.1.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10"
  }
}
