# API environment. Copy to `.env` on a fresh clone.
#
# The app itself only reads `process.env`. Nx loads this file into the
# environment for every API task; a deployed container gets the same variables
# from its task definition instead.

# Port the NestJS server listens on
PORT=4000

# Origin allowed to call the API (the web app)
WEB_ORIGIN=http://localhost:3000

# Local Postgres from docker-compose.yml at the repository root.
DATABASE_URL=postgresql://cvjobs:cvjobs_dev_password@localhost:5432/cvjobs

# Deployments that supply the parts separately (an RDS secret through ECS) can
# leave DATABASE_URL unset and provide these instead:
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# Optional override; defaults to 5 in development and 20 in production.
# DATABASE_POOL_MAX=10

# Connections pg-boss keeps, separate from the pool above. Optional; default 4.
# QUEUE_POOL_MAX=4

# Signs both access and refresh tokens. Required - there is no fallback in code.
# This value is fine for local work; generate your own for anything shared:
#   openssl rand -base64 48
JWT_SECRET=fv13am6mFKHQlD1MnD2p0L2aj6AVZUgrRaK+K9f1+WRPhl6GSeaUANcs+bmj2v84

# Access token lifetime in seconds. 60 keeps the refresh path exercised by
# ordinary use; a deployment should raise this to 900.
ACCESS_TOKEN_TTL=60

# Refresh token lifetime in seconds (7 days). Not extended on use, so a session
# ends this long after it began.
REFRESH_TOKEN_TTL=604800

# Object storage. Locally this is the MinIO container from docker-compose.yml;
# a deployment points at a real bucket.
S3_BUCKET=cvjobs-resumes

# Signed into every presigned URL, so it has to match between signing and
# verifying. MinIO ignores the value itself.
S3_REGION=us-east-1

# Seconds a presigned upload URL stays valid.
UPLOAD_URL_TTL=300

# Development only. Production leaves all three unset: the endpoint is derived
# from the region, and credentials come from the ECS task role rather than from
# a static key pair sitting in a task definition.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=cvjobs
S3_SECRET_ACCESS_KEY=cvjobs_dev_password

# Resume extraction. Get one from https://aistudio.google.com/apikey - the free
# tier needs no card. Only the worker calls Gemini; the API just enqueues.
# A deployment reads this from Secrets Manager rather than a task definition.
GOOGLE_GEMINI_API_KEY=your-key-here

# Optional overrides for the extraction call.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=60000
