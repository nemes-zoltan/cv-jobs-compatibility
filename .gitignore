# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Environment files (keep .env.example tracked)
.env
.env.*
!.env.example

# System Files
.DS_Store
Thumbs.db

# Local MinIO data, bind-mounted by docker-compose.yml. The directory is tracked
# so a fresh clone has somewhere to mount before the container starts; nothing
# inside it ever is. These four lines are order-dependent - `tmp` above excludes
# the directory, and git will not look inside an excluded directory, so it has
# to be re-included before anything in it can be.
!/tmp/
/tmp/*
!/tmp/.gitkeep

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

# Next.js
.next
out
test-output
dist-worker
